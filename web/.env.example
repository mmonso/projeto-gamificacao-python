# Copie para .env.local e preencha com os dados do projeto Supabase de desenvolvimento.
# Nunca coloque valores reais neste arquivo.
# O servidor valida tudo no primeiro uso (src/servidor/config.ts) e diz quais variáveis faltam.

# desenvolvimento, homologacao ou producao. Sem valor: producao quando NODE_ENV=production, senão
# desenvolvimento. Homologação precisa ser declarada, porque na Vercel ela também roda como production.
SIBI_AMBIENTE=

# Conexão PostgreSQL do Supabase usada pelo servidor: pooler em modo sessão (porta 5432). O modo transação
# (6543) perdia respostas de consultas paralelas com o postgres.js.
DATABASE_URL=
# Conexão direta, usada só para aplicar migrações.
DATABASE_URL_MIGRACOES=

# Endereço e chave pública do projeto Supabase (Auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site, usado nos links dos e-mails de conta. Obrigatório em homologação e produção
# (com https); em desenvolvimento, sem ele vale o endereço da requisição; na Vercel, o domínio de produção do
# projeto. Precisa estar nas Redirect URLs
# do Supabase Auth.
URL_DO_SITE=
